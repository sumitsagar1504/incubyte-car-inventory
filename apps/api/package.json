{
  "name": "@inventory/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests prisma --ext .ts",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {"@prisma/client": "^6.16.3", "bcryptjs": "^3.0.2", "cors": "^2.8.5", "dotenv": "^17.2.2", "express": "^5.1.0", "express-rate-limit": "^8.1.0", "jsonwebtoken": "^9.0.2", "pino": "^9.12.0", "pino-http": "^10.5.0", "swagger-ui-express": "^5.0.1", "zod": "^4.1.11"},
  "devDependencies": {"@types/bcryptjs": "^2.4.6", "@types/cors": "^2.8.19", "@types/express": "^5.0.3", "@types/jsonwebtoken": "^9.0.10", "@types/node": "^24.5.2", "@types/supertest": "^6.0.3", "@types/swagger-ui-express": "^4.1.8", "@vitest/coverage-v8": "^3.2.4", "eslint": "^9.36.0", "prisma": "^6.16.3", "supertest": "^7.1.4", "tsx": "^4.20.6", "typescript": "^5.9.2", "vitest": "^3.2.4"}
}
